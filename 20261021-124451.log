--- /etc/hang-monitor.conf ---
# Цели мониторинга обнаруживаются автоматически по /proc/mounts каждый цикл.
# Принудительный override (имя из /proc/diskstats) раскомментируйте при необходимости:
# DISK="nvme0n1"
INTERVAL=5
COOLDOWN=300
# Средняя задержка I/O за интервал, мс (на каждую смонтированную цель)
IO_THRESHOLD_MS=100
# Утилизация цели, %
UTIL_THRESHOLD=90
# PSI I/O some avg10
PSI_THRESHOLD=50
# Количество процессов в D-state
DSTATE_THRESHOLD=1
# Использование /tmp, %
TMP_USED_THRESHOLD=85
# МБ за интервал процессами, похожими на logcheck
LOGCHECK_DELTA_MB=20
# Сколько топ-процессов по I/O писать в строку метрик
TOP_N=3
